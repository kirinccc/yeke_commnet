<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hmdp.mapper.FollowMapper">

    <insert id="follow">
        insert into tb_follow(user_id, follow_user_id) values(#{userId}, #{id})
    </insert>
    <delete id="unfollow">
        delete from tb_follow where user_id = #{userId} and follow_user_id = #{id}
    </delete>
</mapper>
